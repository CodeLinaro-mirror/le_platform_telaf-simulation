{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "power.set_state.req",
  "title": "Set Activity State Request",
  "type": "object",
  "required": ["state", "machineName"],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["UNKNOWN", "SUSPEND", "RESUME", "SHUTDOWN"]
    },
    "machineName": {
      "type": "string",
      "description": "Target machine name, or ALL_MACHINES/LOCAL_MACHINE sentinel."
    }
  },
  "additionalProperties": false
}
