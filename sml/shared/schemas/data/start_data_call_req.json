{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data.start_data_call.req",
  "title": "Start Data Call Request",
  "type": "object",
  "required": ["profileId", "ipFamily", "opType", "slot"],
  "properties": {
    "profileId": {
      "type": "integer",
      "description": "Profile id to bring up the call against."
    },
    "ipFamily": {
      "type": "string",
      "enum": ["IPV4", "IPV6", "IPV4V6", "UNKNOWN"]
    },
    "ifname": {
      "type": "string",
      "description": "Requested interface name; empty lets the server pick from its pool."
    },
    "opType": {
      "type": "string",
      "enum": ["DATA_LOCAL", "DATA_REMOTE"]
    },
    "slot": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
