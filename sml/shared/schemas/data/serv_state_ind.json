{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data.serv_state.ind",
  "title": "Serving System State Indication",
  "type": "object",
  "required": ["serviceState", "networkRat", "drbStatus"],
  "properties": {
    "serviceState": { "type": "string", "enum": ["IN_SERVICE", "OUT_OF_SERVICE", "UNKNOWN"] },
    "networkRat": { "type": "string", "enum": ["GSM", "WCDMA", "LTE", "NR5G", "CDMA_1X", "CDMA_EVDO", "UNKNOWN"] },
    "drbStatus": { "type": "string", "enum": ["ACTIVE", "DORMANT", "UNKNOWN"] }
  },
  "additionalProperties": false
}
