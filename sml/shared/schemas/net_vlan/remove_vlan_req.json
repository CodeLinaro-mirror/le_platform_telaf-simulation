{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "net_vlan.remove_vlan.req",
  "title": "Remove VLAN Request",
  "type": "object",
  "required": ["vlanId", "ifaceType"],
  "properties": {
    "vlanId": { "type": "integer", "minimum": 1, "maximum": 4094 },
    "ifaceType": {
      "type": "string",
      "enum": ["UNKNOWN", "WLAN", "ETH", "ECM", "RNDIS", "MHI", "VMTAP0",
               "VMTAP1", "ETH2", "AP_PRIMARY", "AP_SECONDARY", "AP_TERTIARY",
               "AP_QUATERNARY"]
    }
  },
  "additionalProperties": false
}
