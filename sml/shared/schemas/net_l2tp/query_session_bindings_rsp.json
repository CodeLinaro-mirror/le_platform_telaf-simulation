{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "net_l2tp.query_session_bindings.rsp",
  "title": "Query L2TP Session Bindings Response",
  "type": "object",
  "required": [
    "bindings"
  ],
  "properties": {
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "locId",
          "backhaul"
        ],
        "properties": {
          "backhaul": {
            "type": "string",
            "enum": [
              "ETH",
              "USB",
              "WLAN",
              "WWAN",
              "BLE"
            ]
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "profileId": {
            "type": "integer"
          },
          "bhVlanId": {
            "type": "integer",
            "description": "Set only when the backhaul is itself a VLAN; mirrors BackhaulInfo::vlanId."
          },
          "locId": {
            "type": "integer",
            "minimum": 0,
            "description": "Local session id to bind; mirrors L2tpSessionBindConfig::locId."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
