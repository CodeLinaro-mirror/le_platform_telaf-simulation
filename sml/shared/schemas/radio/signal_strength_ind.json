{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radio.signal_strength.ind",
  "title": "Signal Strength Change Indication",
  "description": "Same shape as radio.request_signal_strength.rsp -- a listener gets the full snapshot and needs no follow-up query, mirroring the SDK's onSignalStrengthChanged(SignalStrength) callback which also carried the whole object.",
  "type": "object",
  "required": ["gsm", "wcdma", "lte", "nr5g"],
  "properties": {
    "gsm": {
      "type": "object",
      "required": ["gsmSignalStrength", "gsmBitErrorRate"],
      "properties": {
        "gsmSignalStrength": { "type": "integer" },
        "gsmBitErrorRate": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "wcdma": {
      "type": "object",
      "required": ["signalStrength", "bitErrorRate", "ecio", "rscp"],
      "properties": {
        "signalStrength": { "type": "integer" },
        "bitErrorRate": { "type": "integer" },
        "ecio": { "type": "integer" },
        "rscp": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "lte": {
      "type": "object",
      "required": ["lteSignalStrength", "lteRsrp", "lteRsrq", "lteRssnr", "lteCqi", "timingAdvance"],
      "properties": {
        "lteSignalStrength": { "type": "integer" },
        "lteRsrp": { "type": "integer" },
        "lteRsrq": { "type": "integer" },
        "lteRssnr": { "type": "integer" },
        "lteCqi": { "type": "integer" },
        "timingAdvance": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "nr5g": {
      "type": "object",
      "required": ["rsrp", "rsrq", "rssnr"],
      "properties": {
        "rsrp": { "type": "integer" },
        "rsrq": { "type": "integer" },
        "rssnr": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
