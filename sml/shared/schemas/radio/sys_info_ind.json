{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radio.sys_info.ind",
  "title": "Serving System Info Change Indication",
  "description": "Same shape as radio.get_system_info.rsp. Backs taf_radio_AddRatChangeHandler -- the PA compares `rat` against the last value it saw and only fires the RAT-change handler on an actual transition, exactly as the SDK's onSystemInfoChanged path did.",
  "type": "object",
  "required": ["rat", "domain", "state"],
  "properties": {
    "rat": {
      "type": "string",
      "enum": [
        "RADIO_TECH_UNKNOWN",
        "RADIO_TECH_GPRS",
        "RADIO_TECH_EDGE",
        "RADIO_TECH_UMTS",
        "RADIO_TECH_LTE",
        "RADIO_TECH_GSM",
        "RADIO_TECH_TD_SCDMA",
        "RADIO_TECH_LTE_CA",
        "RADIO_TECH_NR5G"
      ]
    },
    "domain": {
      "type": "string",
      "enum": ["UNKNOWN", "NO_SRV", "CS_ONLY", "PS_ONLY", "CS_PS", "CAMPED"]
    },
    "state": {
      "type": "string",
      "enum": ["UNKNOWN", "NO_SERVICE", "LIMITED_SERVICE", "IN_SERVICE", "LIMITED_REGIONAL", "POWER_SAVE"]
    }
  },
  "additionalProperties": false
}
