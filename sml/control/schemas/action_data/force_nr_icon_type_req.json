{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.data.force_nr_icon_type.req",
  "title": "Force NR Icon Type",
  "type": "object",
  "required": ["iconType"],
  "properties": {
    "iconType": {
      "type": "string",
      "enum": ["BASIC", "UWB", "NONE"]
    },
    "slot": {
      "type": "integer",
      "minimum": 0,
      "default": 1,
      "description": "Which SIM slot's NR icon type to force."
    }
  },
  "additionalProperties": false
}
