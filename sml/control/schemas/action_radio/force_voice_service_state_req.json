{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.radio.force_voice_service_state.req",
  "title": "Force Voice Service State",
  "description": "Forces RadioPhoneAO's voice registration world state, re-publishing mp/ind/radio/voice_service_state. Every field is optional and applied only if present. Backs IPhoneListener::onVoiceServiceStateChanged testing.",
  "type": "object",
  "properties": {
    "voiceServiceState": {
      "type": "string",
      "enum": [
        "NOT_REG_AND_NOT_SEARCHING",
        "REG_HOME",
        "NOT_REG_AND_SEARCHING",
        "REG_DENIED",
        "UNKNOWN",
        "REG_ROAMING"
      ]
    },
    "denialCause": { "type": "integer" },
    "radioTech": {
      "type": "string",
      "enum": [
        "RADIO_TECH_UNKNOWN",
        "RADIO_TECH_GPRS",
        "RADIO_TECH_EDGE",
        "RADIO_TECH_UMTS",
        "RADIO_TECH_LTE",
        "RADIO_TECH_GSM",
        "RADIO_TECH_TD_SCDMA",
        "RADIO_TECH_LTE_CA",
        "RADIO_TECH_NR5G"
      ]
    },
    "slot": {
      "type": "integer",
      "minimum": 0,
      "default": 1,
      "description": "Which SIM slot's voice service state to force."
    }
  },
  "additionalProperties": false
}
