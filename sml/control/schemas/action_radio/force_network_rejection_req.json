{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.radio.force_network_rejection.req",
  "title": "Force Network Rejection",
  "description": "Forces RadioServingSystemAO's network-rejection world state and re-publishes mp/ind/radio/network_rejection. Every field is optional and applied only if present. Backs IServingSystemListener::onNetworkRejection testing.",
  "type": "object",
  "properties": {
    "rat": {
      "type": "string",
      "enum": [
        "RADIO_TECH_UNKNOWN",
        "RADIO_TECH_GPRS",
        "RADIO_TECH_EDGE",
        "RADIO_TECH_UMTS",
        "RADIO_TECH_LTE",
        "RADIO_TECH_GSM",
        "RADIO_TECH_TD_SCDMA",
        "RADIO_TECH_LTE_CA",
        "RADIO_TECH_NR5G"
      ]
    },
    "domain": {
      "type": "string",
      "enum": ["UNKNOWN", "NO_SRV", "CS_ONLY", "PS_ONLY", "CS_PS", "CAMPED"]
    },
    "rejectCause": { "type": "integer" },
    "mcc": { "type": "string" },
    "mnc": { "type": "string" },
    "slot": {
      "type": "integer",
      "minimum": 0,
      "default": 1,
      "description": "Which SIM slot's network rejection to force."
    }
  },
  "additionalProperties": false
}
