ARG UBUNTU_DISTRO_ORIGIN=ubuntu:22.04
FROM $UBUNTU_DISTRO_ORIGIN

# APT_INSECURE: set to "yes" to disable apt GPG signature verification.
#   - Default ("no"): standard, secure apt behavior.
#   - "yes":  Use only in TRUSTED networks (e.g. corporate intranet behind an
#             HTTPS-inspecting proxy that breaks Ubuntu repository GPG signatures).
#             Typical symptom that requires this:
#               "W: GPG error: ... At least one invalid signature was encountered."
#   Usage:
#     docker build --build-arg APT_INSECURE=yes ...
#     make simula-build-runtime APT_INSECURE=yes
ARG APT_INSECURE=no

# Avoid interactive prompts for all apt operations
ENV DEBIAN_FRONTEND=noninteractive

# Step 1: Optionally disable apt signature verification (only when APT_INSECURE=yes),
#         then install all apt packages in one layer.
#         Combining update + install + cleanup in a single RUN prevents:
#           - stale apt cache across layers (GPG signature failures)
#           - leftover cache files bloating the image (/var/cache/apt/archives)
RUN if [ "$APT_INSECURE" = "yes" ]; then \
        echo ">>> WARNING: APT signature verification is DISABLED (APT_INSECURE=yes) <<<"; \
        echo 'Acquire::AllowInsecureRepositories "true";'             >  /etc/apt/apt.conf.d/99-insecure; \
        echo 'Acquire::AllowDowngradeToInsecureRepositories "true";'  >> /etc/apt/apt.conf.d/99-insecure; \
        echo 'APT::Get::AllowUnauthenticated "true";'                 >> /etc/apt/apt.conf.d/99-insecure; \
    fi \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update \
    && apt-get -y --no-install-recommends install ca-certificates gnupg \
    && update-ca-certificates \
    && apt-get -y --no-install-recommends install \
        sudo \
        build-essential \
        coreutils \
        psmisc \
        policycoreutils \
        busybox-syslogd \
        kmod \
        file \
        lsb-release \
        less \
        nano \
        tree \
        strace \
        gdb \
        tcpdump \
        vlan \
        cgroup-tools \
        openssh-client \
        openssh-server \
        network-manager \
        net-tools \
        iproute2 \
        iputils-ping \
        libasound2-dev \
        alsa-utils \
        alsa-tools \
        pulseaudio \
        pulseaudio-utils \
        libcap-dev \
        libboost-serialization-dev \
        libsqlite3-dev \
        libglib2.0-dev \
        python2 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Step 2: Install all Python packages in one layer, no pip cache left behind.
RUN python3 -m pip install --no-cache-dir \
        doipclient==1.1.1 \
        udsoncan==1.23.2 \
        pyyaml==6.0.1 \
        oyaml==1.0 \
        supervisor==4.2.5 \
        supervisor-stdout==0.1.1

# Step 3: System configuration.
RUN ln -sf /bin/bash /bin/sh \
    && echo 'root:simula' | chpasswd

WORKDIR /root

# Distinguish between container and host (process-level env var)
ENV TELAF_IN_CONTAINER=yes

# Step 4: Shell environment for interactive sessions.
RUN echo "TELAF_IN_CONTAINER=yes" >> ~/.bashrc \
    && echo 'if [ "`id -u`" -eq 0 ]; then PS1="[TelAF Simulation] \\u:\\w # "; else PS1="[TelAF Simulation] \\u:\\w $ "; fi' >> ~/.bashrc \
    && echo 'if [ -f $HOME/simulation/up_simulation.sh ]; then . $HOME/simulation/up_simulation.sh; else echo "Not found $HOME/simulation/up_simulation.sh --> NO simulation"; exit 0; fi' >> ~/.bashrc
